[32m+[m
[32m+[m[32mimport time[m
[32m+[m[32mfrom fastapi import Request[m
[32m+[m
[32m+[m[32m# Simple in-memory rate limiter (in production use Redis!)[m
[32m+[m[32mRATE_LIMIT_STORE = {}[m
[32m+[m
[32m+[m[32masync def rate_limiter(request: Request):[m
[32m+[m[32m    client_ip = request.client.host[m
[32m+[m[32m    current_time = time.time()[m
[32m+[m[41m    [m
[32m+[m[32m    # 5 requests per 60 seconds[m
[32m+[m[32m    limit = 5[m
[32m+[m[32m    window = 60[m
[32m+[m[41m    [m
[32m+[m[32m    if client_ip not in RATE_LIMIT_STORE:[m
[32m+[m[32m        RATE_LIMIT_STORE[client_ip] = [][m
[32m+[m[41m        [m
[32m+[m[32m    # Clean old requests[m
[32m+[m[32m    RATE_LIMIT_STORE[client_ip] = [[m
[32m+[m[32m        timestamp for timestamp in RATE_LIMIT_STORE[client_ip][m[41m [m
[32m+[m[32m        if current_time - timestamp < window[m
[32m+[m[32m    ][m
[32m+[m[41m    [m
[32m+[m[32m    if len(RATE_LIMIT_STORE[client_ip]) >= limit:[m
[32m+[m[32m        raise HTTPException(status_code=429, detail="Too many requests. Please wait a moment.")[m
[32m+[m[41m        [m
[32m+[m[32m    RATE_LIMIT_STORE[client_ip].append(current_time)[m
[32m+[m[32m    return True[m
