# Frontend Environment Configuration
# When deploying to production (Vercel, Render, Netlify, Cloudflare), set this variable to your deployed backend API domain.
# If omitted or running locally during dev, it automatically defaults to http://127.0.0.1:8000/api/v1 for localhost access.
VITE_API_URL=http://127.0.0.1:8000/api/v1
